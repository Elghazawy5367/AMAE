```bash 
# ================================================================ 
# AMAE — Environment Variables 
# Copy to .env for local development 
# Add ALL of these to: GitHub repo → Settings → Secrets → Actions 
# ================================================================ 
 
# ── REQUIRED: AI Generation 
────────────────────────────────────── 
# Primary AI provider (free tier available) 
# Get key at: https://openrouter.ai/keys 
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key 
 
# Anthropic Claude (synthesis + strategy — premium quality) 
# Get key at: https://console.anthropic.com 
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key 
 
# Groq (fast free classification — 14,400 req/day free) 
# Get key at: https://console.groq.com 
GROQ_API_KEY=gsk_replace-with-your-key 
 
# ── REQUIRED: GitHub 
───────────────────────────────────────────── 
# Auto-injected by GitHub Actions — DO NOT add manually 
# GITHUB_TOKEN is provided automatically 
 
# ── PHASE 3: TEXT DISTRIBUTION 
─────────────────────────────────── 
 
# LinkedIn Pages API — https://www.linkedin.com/developers/ 
LINKEDIN_ACCESS_TOKEN= 
LINKEDIN_PERSON_URN=urn:li:person:REPLACE 
 
# Twitter / X API v2 — https://developer.twitter.com 
TWITTER_API_KEY= 
TWITTER_API_SECRET= 
TWITTER_ACCESS_TOKEN= 
TWITTER_ACCESS_SECRET= 
 
# Threads API — https://developers.facebook.com/docs/threads 
THREADS_ACCESS_TOKEN= 
THREADS_USER_ID= 
 
# Beehiiv — https://app.beehiiv.com → Settings → API 
BEEHIIV_API_KEY= 
BEEHIIV_PUBLICATION_ID= 
 
# ── PHASE 4: VISUAL DISTRIBUTION 
───────────────────────────────── 
 
# Instagram Graph API — https://developers.facebook.com/docs/instagram-api 
INSTAGRAM_ACCESS_TOKEN= 
INSTAGRAM_ACCOUNT_ID= 
 
# Facebook Graph API — https://developers.facebook.com 
FACEBOOK_PAGE_ACCESS_TOKEN= 
FACEBOOK_PAGE_ID= 
 
# TikTok Content Posting API — https://developers.tiktok.com 
TIKTOK_ACCESS_TOKEN= 
TIKTOK_CLIENT_KEY= 
TIKTOK_CLIENT_SECRET= 
 
# YouTube Data API v3 — https://console.cloud.google.com 
YOUTUBE_ACCESS_TOKEN= 
YOUTUBE_REFRESH_TOKEN= 
YOUTUBE_CLIENT_ID= 
YOUTUBE_CLIENT_SECRET= 
YOUTUBE_CHANNEL_ID= 
 
# Pinterest API v5 — https://developers.pinterest.com 
PINTEREST_ACCESS_TOKEN= 
PINTEREST_BOARD_ID= 
 
# Product Hunt API — https://api.producthunt.com/v2/docs 
PRODUCTHUNT_API_TOKEN= 
 
# ── PHASE 5: MEDIA PRODUCTION 
──────────────────────────────────── 
 
# Ideogram v3 — https://ideogram.ai/manage-api 
# 25 free generations/day 
IDEOGRAM_API_KEY= 
 
# ElevenLabs TTS — https://elevenlabs.io 
# 10,000 chars/month free 
ELEVENLABS_API_KEY= 
ELEVENLABS_VOICE_ID= 
 
# HeyGen — https://app.heygen.com/api-key 
# Creator plan required (~$29/month) 
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=    # Get from HeyGen dashboard → Voices → copy the voice ID 
HEYGEN_AVATAR_ID= 
 
# Runway Gen-3 — https://runwayml.com 
# Standard plan (~$12/month) 
RUNWAY_API_KEY= 
 
# ── LOCAL DEVELOPMENT ONLY 
─────────────────────────────────────── 
# These override GitHub Actions secrets when running locally 
# Never commit .env — it is in .gitignore 
``` 
 
